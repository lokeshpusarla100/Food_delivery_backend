# Copy to /opt/food-delivery/staging.env on the staging machine and chmod 600.
# This file contains NO real credentials; use secret manager provisioning.
# The Jenkins deploy step supplies IMAGE_TAG as the verified commit SHA.
IMAGE_TAG=
GATEWAY_BIND_PORT=8080
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
RESTAURANT_OUTBOX_ENABLED=false
USER_JWT_SECRET=
USER_INTERNAL_API_KEY=
RESTAURANT_INTERNAL_API_KEY=
RESTAURANT_PLATFORM_ADMIN_KEY=
USER_DB_USERNAME=
USER_DB_PASSWORD=
RESTAURANT_DB_USERNAME=
RESTAURANT_DB_PASSWORD=
ORDER_DB_USERNAME=
ORDER_DB_PASSWORD=
PAYMENT_DB_USERNAME=
PAYMENT_DB_PASSWORD=
DELIVERY_DB_USERNAME=
DELIVERY_DB_PASSWORD=
NOTIFICATION_DB_USERNAME=
NOTIFICATION_DB_PASSWORD=
FLEET_DB_USERNAME=
FLEET_DB_PASSWORD=
FEEDBACK_DB_USERNAME=
FEEDBACK_DB_PASSWORD=
ANALYTICS_DB_USERNAME=
ANALYTICS_DB_PASSWORD=
