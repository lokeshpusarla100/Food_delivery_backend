# Runtime-only image: compile and verify with Maven on a trusted Jenkins agent first.
FROM eclipse-temurin:17-jre-jammy
ARG SERVICE_NAME
ARG REVISION=unknown
LABEL org.opencontainers.image.source="https://github.com/lokeshpusarla100/Food_delivery_backend"
LABEL org.opencontainers.image.revision="$REVISION"
RUN groupadd -g 10001 food && useradd -u 10001 -g 10001 -m -s /usr/sbin/nologin food
WORKDIR /app
COPY --chown=10001:10001 ${SERVICE_NAME}/target/${SERVICE_NAME}-1.0.0-SNAPSHOT.jar /app/app.jar
USER 10001:10001
EXPOSE 8080
ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=70 -XX:+ExitOnOutOfMemoryError"
ENTRYPOINT ["java","-jar","/app/app.jar"]
